<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AdvancedWebViewSample.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AdvancedWebViewSample"
    Title="AdvancedWebView">

    <TabBar>
        <ShellContent
            Title="Browser"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Bridge"
            ContentTemplate="{DataTemplate local:BridgePage}"
            Route="BridgePage" />
    </TabBar>

</Shell>
